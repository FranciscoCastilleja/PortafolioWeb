---
import { getI18N } from '../i18n/';
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale })
---

<section id="proyectos" class="gsap-reveal space-y-8">
    <div class="flex items-center justify-between border-b border-line pb-4">
        <h2 class="text-xs uppercase tracking-[0.3em] font-mono text-zinc-500" data-i18n="sec_proj_title">02 / {i18n.Menu_OP_2}</h2>
    </div>
    <div class="grid grid-cols-1 gap-6">
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">
                <img class="rounded-lg size-full object-cover lg:order-2 zoom" src="/media/Planify.webp" alt="Foto de la página Planify" />
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">Planify</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_1_Description_1}</p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_1_Description_2}</p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>Astro</span> • <span>Neon</span> • <span>TypeScript</span> • <span>JavaScript</span> • <span>HTML</span> • <span>CSS</span> • <span>Stripe</span> • <span>Cloudflare</span>
            </div>
            <span class="flex mt-2 py-1 gap-x-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://theplanify.vercel.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
            </span>
        </div>
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">
                <img class="rounded-lg size-full object-cover lg:order-2 zoom" src="/media/ECommerceApp.webp" alt="Foto de la página E-Commerce App" />
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">E-Commerce App</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_2_Description_1}</p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_2_Description_2}</p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>Nuxt</span> • <span>TypeScript</span> • <span>HTML</span> • <span>Tailwind CSS</span> • <span>Vercel</span>
            </div>
            <span class="flex flex-col mt-2 py-1 gap-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://ecommerce-app-nuxt.vercel.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://github.com/FranciscoCastilleja/ecommerce-app" target="_blank" rel="noopener noreferrer">
                    GitHub
                </a>
            </span>
        </div>
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">
                <img class="rounded-lg size-full object-cover lg:order-2 zoom" src="/media/MarvelKnight.webp" alt="Foto de la página _MarvelKnight_" />
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">MarvelKnight</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_3_Description_1}</p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_3_Description_2}</p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>Astro</span> • <span>TypeScript</span> • <span>HTML</span> • <span>CSS</span> • <span>Tailwind CSS</span> • <span>Vercel</span>
            </div>
            <span class="flex mt-2 py-1 gap-x-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://marvelknight.vercel.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
            </span>
        </div>
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">
                <img class="rounded-lg size-full object-cover lg:order-2 zoom" src="/media/StarWarsChronology.webp" alt="Foto de la página Star Wars Chronology" />
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">Star Wars Chronology</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_4_Description_1}</p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_4_Description_2}</p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>NextJs</span> • <span>React</span> • <span>TypeScript</span> • <span>HTML</span> • <span>CSS</span> • <span>Tailwind CSS</span> • <span>Vercel</span> • <span>Supabase</span>
            </div>
            <span class="flex flex-col mt-2 py-1 gap-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://starwars-chronology.vercel.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://github.com/FranciscoCastilleja/StarWarsProject" target="_blank" rel="noopener noreferrer">
                    GitHub
                </a>
            </span>
        </div>
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">
                <img class="rounded-lg size-full object-cover lg:order-2 zoom" src="/media/SpaceX-Clon-IMG-1.webp" alt="Foto de la página SpaceX - Clon" />
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">SpaceX - Clon</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_5_Description_1}</p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc">{i18n.P_5_Description_2}</p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>Astro</span> • <span>JavaScript</span> • <span>HTML</span> • <span>CSS</span> • <span>Tailwind CSS</span> • <span>Netlify</span>
            </div>
            <span class="flex flex-col mt-2 py-1 gap-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://spacexclon.netlify.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://github.com/FranciscoCastilleja/SpaceXClon" target="_blank" rel="noopener noreferrer">
                    GitHub
                </a>
            </span>
        </div>
        <div class="group p-6 rounded-2xl border border-line bg-surface/30 hover:border-zinc-700 transition-all">
            <div class="h-48 rounded-xl bg-surface mb-6 border border-line overflow-hidden relative">

            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-medium text-zinc-100" data-i18n="proj_1_title">Pedro El Asesino</h3>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc"></p>
                    <p class="text-xs text-zinc-400 mt-1 font-light" data-i18n="proj_1_desc"></p>
                </div>
            </div>
            <div class="flex gap-2 mt-6 py-4 border-y border-line/60 text-[10px] font-mono text-zinc-400 uppercase">
                <span>Astro</span> • <span>JavaScript</span> • <span>HTML</span> • <span>CSS</span> • <span>TypeScript</span> • <span>GSAP</span>
            </div>
            <span class="flex mt-2 py-1 gap-x-1">
                <a class="text-[10px] font-mono text-zinc-400 uppercase hover:text-white transition-all" href="https://pedro-el-asesino.vercel.app/" target="_blank" rel="noopener noreferrer">
                    {i18n.P_Btn}
                </a>
            </span>
        </div>
    </div>
</section>