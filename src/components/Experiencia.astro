---
import AstroIcon from './icons/AstroIcon.astro';
import ReactIcon from './icons/ReactIcon.astro';
import PostgreSQLIcon from './icons/PostgreSQLIcon.astro';
import TailwindCSSIcon from './icons/TailwindCSSIcon.astro';
import TypeScriptIcon from './icons/TypeScriptIcon.astro';
import JavaScriptIcon from './icons/JavaScriptIcon.astro';
import HTML5Icon from './icons/HTML5Icon.astro';
import CSSIcon from './icons/CSSIcon.astro';
import JWTIcon from './icons/JWTIcon.astro';

import { getI18N } from '../i18n/';
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale })
---

<section id="experiencia" class="gsap-reveal space-y-8">
    <div class="flex items-center justify-between border-b border-[#27272a] pb-4">
        <h2 class="text-xs uppercase tracking-[0.3em] font-mono text-zinc-500" data-i18n="sec_exp_title">01 / {i18n.Menu_OP_1}</h2>
    </div>
    <div class="space-y-12">
        <div class="group relative pl-6 border-l border-[#27272a] hover:border-zinc-200 transition-colors">
            <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-zinc-100 transition-colors"></div>
            <span class="text-xs text-zinc-500 font-mono">{i18n.Exp_1_Date}</span>
            <h3 class="text-xl font-medium tracking-tight mt-1 text-zinc-200">{i18n.Exp_1_Header}</h3>
            <p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed" data-i18n="exp_desc">
                {i18n.Exp_1_Description}
            </p>
            <span class="flex mt-5">
                <AstroIcon width="25" height="25"/>
                <ReactIcon width="25" height="25" class="ml-2"/>
                <PostgreSQLIcon width="25" height="25" class="ml-2"/>
                <TailwindCSSIcon width="25" height="25" class="ml-2"/>
                <TypeScriptIcon width="25" height="25" class="ml-2"/>
                <JavaScriptIcon width="25" height="25" class="ml-2"/>
                <HTML5Icon width="25" height="25" class="ml-2"/>
                <CSSIcon width="25" height="25" class="ml-2"/>
                <JWTIcon width="25" height="25" class="ml-2"/>
            </span>
        </div>
        <div class="group relative pl-6 border-l border-[#27272a] hover:border-zinc-200 transition-colors">
            <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-zinc-600 group-hover:bg-zinc-100 transition-colors"></div>
            <span class="text-xs text-zinc-500 font-mono">{i18n.Exp_2_Date}</span>
            <h3 class="text-xl font-medium tracking-tight mt-1 text-zinc-200">{i18n.Exp_2_Header}</h3>
            <p class="text-sm text-zinc-400 mt-2 font-light leading-relaxed" data-i18n="exp_desc">
                {i18n.Exp_2_Description}
            </p>
            <span class="flex mt-5">
                <AstroIcon width="25" height="25"/>
                <ReactIcon width="25" height="25" class="ml-2"/>
                <PostgreSQLIcon width="25" height="25" class="ml-2"/>
                <TailwindCSSIcon width="25" height="25" class="ml-2"/>
                <TypeScriptIcon width="25" height="25" class="ml-2"/>
                <JavaScriptIcon width="25" height="25" class="ml-2"/>
                <HTML5Icon width="25" height="25" class="ml-2"/>
                <CSSIcon width="25" height="25" class="ml-2"/>
                <JWTIcon width="25" height="25" class="ml-2"/>
            </span>
        </div>
    </div>
</section>