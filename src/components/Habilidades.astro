---
import { getI18N } from '../i18n/';
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale })
---

<section id="habilidades" class="gsap-reveal space-y-8">
    <div class="flex items-center justify-between border-b border-line pb-4">
        <h2 class="text-xs uppercase tracking-[0.3em] font-mono text-zinc-500" data-i18n="sec_skills_title">03 / {i18n.Menu_OP_3}</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">HTML</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">CSS</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Tailwind CSS</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">JavaScript</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">TypeScript</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Astro</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">NextJs</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">React</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Git</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">GitHub</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Vercel</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Netlify</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Supabase</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">NodeJs</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">ExpressJs</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">PostgreSQL</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">MySQL</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Microsoft SQL Server</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Angular</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Stripe</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Nuxt</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Figma</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">PHP</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Markdown</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">Python</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">JWT</div>
        <div class="p-4 rounded-xl border border-line bg-surface/20 text-xs font-mono text-zinc-300">GSAP</div>
    </div>
</section>