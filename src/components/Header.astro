---
import EmailIcon from './icons/EmailIcon.astro';

import { getI18N } from '../i18n/';
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale })
---

<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div id="side-badge" class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#27272a] bg-[#141417]/50 text-[11px] font-mono tracking-widest uppercase text-zinc-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span data-i18n="badge">{i18n.Span_Header}</span>
        </div>
        <div class="inline-flex rounded-lg border border-[#27272a] bg-[#141417]/50 p-0.5 text-[11px] font-mono">
            <a href="/" class="px-2.5 py-1 rounded-md transition-all text-zinc-100 bg-zinc-800">ES</a>
            <a href="/en" class="px-2.5 py-1 rounded-md transition-all text-zinc-400 hover:text-zinc-100">EN</a>
        </div>
    </div>
    <div class="space-y-4">
        <h1 id="side-title" class="text-4xl lg:text-6xl font-light tracking-tight font-serif-editorial leading-none" data-i18n="title">
            {i18n.Header_1}
        </h1>
        <p id="side-desc" class="text-zinc-400 text-2xl font-light leading-relaxed max-w-sm" data-i18n="desc">
            Francisco Castilleja
        </p>
    </div>
    <nav id="side-nav" class="hidden lg:flex flex-col gap-2 pt-6 text-xs font-mono tracking-widest text-zinc-500 uppercase">
        <a href="#experiencia" class="hover:text-zinc-100 transition-colors flex items-center gap-4 group">
            <span class="w-6 h-[1px] bg-[#27272a] group-hover:w-12 group-hover:bg-zinc-100 transition-all"></span> <span data-i18n="nav_exp">01. {i18n.Menu_OP_1}</span>
        </a>
        <a href="#proyectos" class="hover:text-zinc-100 transition-colors flex items-center gap-4 group">
            <span class="w-6 h-[1px] bg-[#27272a] group-hover:w-12 group-hover:bg-zinc-100 transition-all"></span> <span data-i18n="nav_proyectos">02. {i18n.Menu_OP_2}</span>
        </a>
        <a href="#habilidades" class="hover:text-zinc-100 transition-colors flex items-center gap-4 group">
            <span class="w-6 h-[1px] bg-[#27272a] group-hover:w-12 group-hover:bg-zinc-100 transition-all"></span> <span data-i18n="nav_habilidades">03. {i18n.Menu_OP_3}</span>
        </a>
        <a href="#estudios" class="hover:text-zinc-100 transition-colors flex items-center gap-4 group">
            <span class="w-6 h-[1px] bg-[#27272a] group-hover:w-12 group-hover:bg-zinc-100 transition-all"></span> <span data-i18n="nav_estudios">04. {i18n.Menu_OP_4}</span>
        </a>
    </nav>
</div>
<div id="side-links" class="pt-10 lg:pt-0 flex flex-wrap gap-3 items-center">
    <button id="openResume" class="px-4 py-2 rounded-lg border border-[#27272a] bg-[#141417] hover:bg-zinc-800 text-xs font-mono uppercase tracking-wider transition-all" data-i18n="link_cv">CV</button>
    <a href="https://linkedin.com/in/francisco-castilleja" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg border border-[#27272a] bg-[#141417] hover:bg-zinc-800 text-xs font-mono uppercase tracking-wider transition-all">LinkedIn</a>
    <a href="https://github.com/FranciscoCastilleja" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg border border-[#27272a] bg-[#141417] hover:bg-zinc-800 text-xs font-mono uppercase tracking-wider transition-all">GitHub</a>
    <button class="px-4 py-2 rounded-lg border border-[#27272a] bg-[#141417] hover:bg-zinc-800 text-xs font-mono uppercase tracking-wider transition-all" data-i18n="link_mail" onclick="navigator.clipboard.writeText('Francisco_Castilleja@outlook.com')">
        <EmailIcon class="size-4 text-white"/>
    </button>
</div>